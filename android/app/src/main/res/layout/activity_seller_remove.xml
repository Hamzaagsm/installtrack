<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#101828">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛡️ Management hatao — Qist poori"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView android:id="@+id/tvRemoveStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFD54F"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Seller PIN:" android:textColor="#FFFFFF" />
    <EditText android:id="@+id/etRemovePin"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="enrollment ke waqt wala PIN"
        android:textColor="#FFFFFF" android:textColorHint="#888888"
        android:inputType="numberPassword"
        android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btnDoRemove"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✅ MANAGEMENT HATAO"
        android:backgroundTint="#7C3AED" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Management hatne ke baad app normal tarike se uninstall ho sakegi. PIN ghalat ho to kuch nahi hoga."
        android:textColor="#9CA3AF"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
